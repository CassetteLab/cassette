# Swift package checkouts. CI builds with `-clonedSourcePackagesDirPath .spm`, so running the
# CI command locally drops several thousand files here; without this, `git status` is unusable.
.spm/
.personal-signing.env
.personal-signing-backup/

# graphify — generated locally, not versioned. graphify's own README suggests committing
# graphify-out/, but its post-commit hook rebuilds the graph after every commit, and a rebuild
# rewrites graph.json wholesale: ~95k changed lines on top of each feature commit. The graph is
# cheap to regenerate (`/graphify`) and worthless as history, so it stays out of the repo.
graphify-out/

# macOS
.DS_Store
/*/.DS_Store
/*/*/.DS_Store

# AltStore ADP downloaded from api.altstore.io for hosting. Contains signed IPAs, each with an
# embedded.mobileprovision — never versioned. Re-downloadable for 5 days via the ADP ID, and
# the hosted copy lives on R2; see .claude/notes/altstore-pal.md.
altstore-adp/
